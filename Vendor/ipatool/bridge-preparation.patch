+package sap
+
+import (
+	"bytes"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestBridgeSAPRestrictsTheSystemTransportToPublicBootstrapEndpoints(t *testing.T) {
+	for _, raw := range []string{"http://s.mzstatic.com/sap/setupCert.plist", "https://s.mzstatic.com.attacker.test/sap/setupCert.plist", "https://user@s.mzstatic.com/sap/setupCert.plist", "https://s.mzstatic.com:8443/sap/setupCert.plist", "https://s.mzstatic.com/sap/setupCert.plist?token=private", "https://s.mzstatic.com/sap/setupCert.plist#fragment", "https://auth.itunes.apple.com/auth/v1/native"} {
+		req, err := http.NewRequest(http.MethodGet, raw, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if bridgeSAPEligible(req) {
+			t.Fatal("accepted a non-public or modified endpoint")
+		}
+	}
+	get, _ := http.NewRequest(http.MethodGet, bridgeCertificateURL, nil)
+	post, _ := http.NewRequest(http.MethodPost, bridgeSetupURL, nil)
+	if !bridgeSAPEligible(get) || !bridgeSAPEligible(post) {
+		t.Fatal("rejected expected Apple endpoints")
+	}
+}
+
+func TestBridgeSAPKeepsHeadersAndHandshakeOutOfCommandArguments(t *testing.T) {
+	payload := []byte("private encrypted handshake\x00binary-data")
+	req, _ := http.NewRequest(http.MethodPost, bridgeSetupURL, bytes.NewReader(payload))
+	req.Header.Set("Cookie", "do-not-forward")
+	req.Header.Set("Authorization", "do-not-forward")
+	req.Header.Set("Content-Type", "application/x-plist")
+	args, body, err := bridgeSAPCommand(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	joined := strings.Join(args, " ")
+	if !bytes.Equal(body, payload) {
+		t.Fatal("handshake bytes changed")
+	}
+	if strings.Contains(joined, "private encrypted") || strings.Contains(joined, "do-not-forward") || strings.Contains(joined, "--insecure") || strings.Contains(joined, "--retry") {
+		t.Fatal("request exposed private data, disabled HTTPS validation, or replayed a stateful POST")
+	}
+	if !strings.Contains(joined, "--data-binary @-") {
+		t.Fatal("handshake is not sent through stdin")
+	}
+}
+
+func TestBridgeSAPLimitsResponseMemoryAndRequestSize(t *testing.T) {
+	buffer := &bridgeBoundedOutput{maximum: 4}
+	n, err := buffer.Write([]byte("12345678"))
+	if err != nil || n != 8 || buffer.Len() != 4 || !buffer.overflow {
+		t.Fatal("unbounded response memory")
+	}
+	req, _ := http.NewRequest(http.MethodPost, bridgeSetupURL, strings.NewReader(strings.Repeat("x", int(maxSetupBody)+1)))
+	if _, _, err := bridgeSAPCommand(req); err == nil {
+		t.Fatal("accepted an oversized handshake")
+	}
+}
+
+func TestBridgeSAPRetriesOnlyThePublicCertificateDownload(t *testing.T) {
+	req, _ := http.NewRequest(http.MethodGet, bridgeCertificateURL, nil)
+	args, body, err := bridgeSAPCommand(req)
+	if err != nil || len(body) != 0 || !strings.Contains(strings.Join(args, " "), "--retry 2") {
+		t.Fatal("public certificate download has no bounded retry")
+	}
+}
+
+func TestBridgeBagAllowsOnlyMachineConfigurationParameters(t *testing.T) {
+	for _, raw := range []string{
+		"https://init.itunes.apple.com/bag.xml?ix=6&guid=001122AABBCC",
+		"https://init.itunes.apple.com/bag.xml?guid=001122aabbcc",
+	} {
+		req, _ := http.NewRequest(http.MethodGet, raw, nil)
+		if !bridgeBagEligible(req) || !bridgeSAPEligible(req) {
+			t.Fatal("rejected public machine configuration")
+		}
+	}
+	for _, raw := range []string{
+		"http://init.itunes.apple.com/bag.xml?guid=001122AABBCC",
+		"https://init.itunes.apple.com.attacker.test/bag.xml?guid=001122AABBCC",
+		"https://init.itunes.apple.com/bag.xml?guid=short",
+		"https://init.itunes.apple.com/bag.xml?guid=001122AABBCC&appleId=private",
+		"https://init.itunes.apple.com/bag.xml?guid=001122AABBCC&guid=001122AABBCC",
+		"https://init.itunes.apple.com/bag.xml?guid=001122AABBCC&ix=other",
+		"https://init.itunes.apple.com/bag.xml?guid=001122AABBCC#fragment",
+	} {
+		req, _ := http.NewRequest(http.MethodGet, raw, nil)
+		if bridgeBagEligible(req) || bridgeSAPEligible(req) {
+			t.Fatal("accepted unrelated parameters or endpoint")
+		}
+	}
+}
+
+func TestBridgeBagPreservesPublicHeadersAndDropsAccountData(t *testing.T) {
+	req, _ := http.NewRequest(http.MethodGet, "https://init.itunes.apple.com/bag.xml?ix=6&guid=001122AABBCC", nil)
+	req.Header.Set("User-Agent", "Configurator-test")
