+package cmd
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/majd/ipatool/v2/pkg/appstore"
+)
+
+// Read exactly one terminal line without buffering characters for the next
+// prompt. A pasted newline inside bracketed-paste markers belongs to the paste.
+func readBridgeTerminalLine(input io.Reader) (string, error) {
+	const start = "\x1b[200~"
+	const end = "\x1b[201~"
+	var buffer []byte
+	var one [1]byte
+	pasteDepth := 0
+	pasteNewline := false
+	for count := 0; count < 8192; count++ {
+		if _, err := io.ReadFull(input, one[:]); err != nil {
+			return "", err
+		}
+		buffer = append(buffer, one[0])
+		if bytes.HasSuffix(buffer, []byte(start)) {
+			buffer = buffer[:len(buffer)-len(start)]
+			pasteDepth++
+			continue
+		}
+		if bytes.HasSuffix(buffer, []byte(end)) {
+			buffer = buffer[:len(buffer)-len(end)]
+			if pasteDepth > 0 {
+				pasteDepth--
+			}
+			if pasteDepth == 0 && pasteNewline {
+				return strings.TrimRight(string(buffer), "\r\n"), nil
+			}
+			continue
+		}
+		if one[0] == '\n' {
+			if pasteDepth > 0 {
+				pasteNewline = true
+				continue
+			}
+			return strings.TrimSuffix(string(buffer[:len(buffer)-1]), "\r"), nil
+		}
+		if one[0] == '\r' && pasteDepth > 0 {
+			pasteNewline = true
+		}
+	}
+	return "", errors.New("input line is too long")
+}
+
+func readBridgeAuthCode(input io.Reader, output io.Writer) (string, error) {
+	for {
+		if _, err := io.WriteString(output, "enter 2FA code: "); err != nil {
+			return "", err
+		}
+		line, err := readBridgeTerminalLine(input)
+		if err != nil {
+			return "", fmt.Errorf("failed to read auth code: %w", err)
+		}
+		code, err := appstore.NormalizeAuthCode(line)
+		if err == nil && code != "" {
+			return code, nil
+		}
+		// Never echo the code or initiate another Apple request for malformed input.
+		if _, err = io.WriteString(output, "Код не распознан. Введи шесть цифр 0–9 ещё раз; пароль сохранён только в этой попытке.\n"); err != nil {
+			return "", err
+		}
+	}
+}
