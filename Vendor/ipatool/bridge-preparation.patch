+package sap
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+const bridgeCertificateURL = "https://s.mzstatic.com/sap/setupCert.plist"
+const bridgeSetupURL = "https://fpinit.itunes.apple.com/v1/signSapSetup/legacy"
+
+type bridgeSAPNetworkError struct{ cause error }
+
+func (e *bridgeSAPNetworkError) Error() string {
+	return "Apple service connection interrupted: " + e.cause.Error()
+}
+func (e *bridgeSAPNetworkError) Unwrap() error { return e.cause }
+
+func bridgeSAPProgress(message string) {
+	if os.Getenv("IPHONE_BRIDGE_PROGRESS") == "1" {
+		fmt.Fprintln(os.Stderr, "[Соединение] "+message)
+	}
+}
+
+// These requests contain only public bootstrap data and the SAP handshake.
+// Account credentials, cookies and authentication requests never use this path.
+func bridgeSAPEligible(request *http.Request) bool {
+	if request == nil || request.URL == nil {
+		return false
+	}
+	u := request.URL
+	if u.Scheme != "https" || u.User != nil || u.Fragment != "" || u.RawPath != "" || (u.Port() != "" && u.Port() != "443") {
+		return false
+	}
+	if bridgeBagEligible(request) {
+		return true
+	}
+	if u.RawQuery != "" {
+		return false
+	}
+	return request.Method == http.MethodGet && u.Hostname() == "s.mzstatic.com" && u.Path == "/sap/setupCert.plist" || request.Method == http.MethodPost && u.Hostname() == "fpinit.itunes.apple.com" && u.Path == "/v1/signSapSetup/legacy"
+}
+
+func bridgeBagEligible(request *http.Request) bool {
+	if request == nil || request.URL == nil || request.Method != http.MethodGet {
+		return false
+	}
+	u := request.URL
+	if u.Scheme != "https" || u.Hostname() != "init.itunes.apple.com" || u.Path != "/bag.xml" || u.User != nil || u.Fragment != "" || u.RawPath != "" || (u.Port() != "" && u.Port() != "443") {
+		return false
+	}
+	query, err := url.ParseQuery(u.RawQuery)
+	if err != nil {
+		return false
+	}
+	for name, values := range query {
+		if len(values) != 1 || name != "guid" && name != "ix" {
+			return false
+		}
+	}
+	guid := query.Get("guid")
+	if len(guid) != 12 || strings.IndexFunc(guid, func(r rune) bool { return !strings.ContainsRune("0123456789abcdefABCDEF", r) }) != -1 {
+		return false
+	}
+	return len(query["ix"]) == 0 || query.Get("ix") == "6"
+}
+
+type bridgeBoundedOutput struct {
+	bytes.Buffer
+	maximum  int
+	overflow bool
+}
+
+func (b *bridgeBoundedOutput) Write(data []byte) (int, error) {
+	length := len(data)
+	remaining := b.maximum - b.Len()
+	if len(data) > remaining {
+		b.overflow = true
+		data = data[:remaining]
+	}
+	_, _ = b.Buffer.Write(data)
+	return length, nil
+}
+
+func bridgeSAPCommand(request *http.Request) ([]string, []byte, error) {
+	if !bridgeSAPEligible(request) {
+		return nil, nil, errors.New("unsupported public SAP endpoint")
+	}
+	args := []string{"--http1.1", "--silent", "--show-error", "--fail", "--proto", "=https", "--connect-timeout", "8", "--max-time", "20", "--max-filesize", strconv.FormatInt(maxSetupBody, 10), "--write-out", "\n%{http_code}", "--request", request.Method, "--url", request.URL.String()}
+	for _, name := range []string{"User-Agent", "Content-Type", "Accept"} {
+		value := request.Header.Get(name)
+		if strings.ContainsAny(value, "\r\n\x00") {
+			return nil, nil, errors.New("invalid SAP header")
+		}
+		if value != "" {
+			args = append(args, "--header", name+": "+value)
+		}
+	}
+	var body []byte
+	if request.Method == http.MethodGet {
+		args = append(args, "--retry", "2", "--retry-all-errors", "--retry-max-time", "45")
+	} else {
+		if request.Body != nil {
+			var err error
+			body, err = io.ReadAll(io.LimitReader(request.Body, maxSetupBody+1))
+			_ = request.Body.Close()
+			if err != nil {
+				return nil, nil, err
+			}
+			if int64(len(body)) > maxSetupBody {
+				return nil, nil, errors.New("SAP request exceeds size limit")
+			}
+		}
+		// The encrypted handshake travels through stdin, never argv or a file.
+		args = append(args, "--data-binary", "@-")
+	}
+	return args, body, nil
+}
+
+func bridgeSAPSend(request *http.Request) ([]byte, error) {
+	args, body, err := bridgeSAPCommand(request)
+	if err != nil {
+		return nil, err
+	}
+	if bridgeBagEligible(request) {
+		bridgeSAPProgress("Загружаю конфигурацию сервисов Apple…")
+	} else if request.Method == http.MethodGet {
+		bridgeSAPProgress("Загружаю служебный сертификат Apple…")
+	} else {
+		bridgeSAPProgress("Устанавливаю защищённое соединение с Apple…")
+	}
+	command := exec.CommandContext(request.Context(), "/usr/bin/curl", args...)
+	command.Stdin = bytes.NewReader(body)
+	output := &bridgeBoundedOutput{maximum: int(maxSetupBody) + 8}
+	diagnostic := &bridgeBoundedOutput{maximum: 512}
+	command.Stdout = output
+	command.Stderr = diagnostic
+	if err = command.Run(); err != nil {
+		var exit *exec.ExitError
+		if errors.As(err, &exit) {
+			switch exit.ExitCode() {
+			case 5, 6, 7, 18, 28, 35, 52, 56:
+				return nil, &bridgeSAPNetworkError{cause: fmt.Errorf("HTTPS request failed (curl %d)", exit.ExitCode())}
+			}
+		}
+		return nil, fmt.Errorf("SAP HTTPS request failed: %w", err)
+	}
+	if output.overflow {
+		return nil, errors.New("SAP response exceeds size limit")
+	}
+	data := output.Bytes()
+	end := bytes.LastIndexByte(data, '\n')
+	if end < 0 {
+		return nil, errors.New("SAP response has no HTTP status")
+	}
+	status, err := strconv.Atoi(string(data[end+1:]))
+	if err != nil || status != http.StatusOK {
+		return nil, fmt.Errorf("Apple SAP returned HTTP %d", status)
+	}
+	if int64(end) > maxSetupBody {
+		return nil, errors.New("SAP response exceeds size limit")
+	}
+	return data[:end], nil
+}
+
+// FetchBridgeURLBag fetches only the public machine configuration. It never
+// forwards account headers, cookies or credentials to a subprocess.
+func FetchBridgeURLBag(ctx context.Context, endpoint string, headers map[string]string) ([]byte, error) {
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, err
+	}
+	if !bridgeBagEligible(request) {
+		return nil, errors.New("unsupported public Apple configuration URL")
+	}
+	for name, value := range headers {
+		request.Header.Set(name, value)
+	}
+	return bridgeSAPSend(request)
+}
+
+// PrepareBridgeSAPCertificate checks this public dependency before any password
+// is requested. It does not read an account or create an authentication session.
+func PrepareBridgeSAPCertificate(ctx context.Context) error {
+	u, _ := url.Parse(bridgeCertificateURL)
+	body, err := bridgeSAPSend((&http.Request{Method: http.MethodGet, URL: u, Header: make(http.Header)}).WithContext(ctx))
+	if err != nil {
+		return err
+	}
+	if _, err = plistBytes(body, setupCertificateKey); err != nil {
+		return err
+	}
+	bridgeSAPProgress("Служебный сертификат Apple доступен.")
+	return nil
+}
+
+// CheckBridgeSAP exercises the whole bootstrap and signer without an Apple ID.
+func CheckBridgeSAP(ctx context.Context) error {
+	signer, err := NewSigner(ctx, Config{SetupURL: bridgeSetupURL, CertificateURL: bridgeCertificateURL, Version: 200, HardwareID: []byte{2, 0, 0, 0, 0, 1}})
+	if err != nil {
+		return err
+	}
+	defer signer.Close()
+	result, err := signer.Sign([]byte("iPhone Bridge public SAP connectivity check"))
+	if err != nil {
+		return err
+	}
+	if len(result) == 0 {
+		return errors.New("SAP signer returned empty result")
+	}
+	return nil
+}
