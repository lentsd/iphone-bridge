+package assets
+
+import (
+	"archive/zip"
+	"bytes"
+	"errors"
+	"io"
+	"math/rand"
+	"testing"
+)
+
+type bridgeCountingReader struct {
+	*bytes.Reader
+	largeReads int
+}
+
+func (r *bridgeCountingReader) ReadAt(data []byte, offset int64) (int, error) {
+	if len(data) > 32*1024 {
+		r.largeReads++
+	}
+	return r.Reader.ReadAt(data, offset)
+}
+
+func bridgeTestEntry(t *testing.T) (*zip.File, *bridgeCountingReader, []byte) {
+	t.Helper()
+	data := make([]byte, 256*1024)
+	_, _ = rand.New(rand.NewSource(17)).Read(data)
+	var buffer bytes.Buffer
+	w := zip.NewWriter(&buffer)
+	entry, err := w.Create("component")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = entry.Write(data); err != nil {
+		t.Fatal(err)
+	}
+	if err = w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	r := &bridgeCountingReader{Reader: bytes.NewReader(buffer.Bytes())}
+	z, err := zip.NewReader(r, int64(buffer.Len()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.largeReads = 0
+	return z.File[0], r, data
+}
+
+func TestBridgeReadsCompressedComponentInOneLargeRange(t *testing.T) {
+	entry, reader, expected := bridgeTestEntry(t)
+	data, err := readBridgeZipEntry(entry, 512*1024)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(data, expected) {
+		t.Fatal("component bytes changed")
+	}
+	if reader.largeReads != 1 {
+		t.Fatalf("large remote reads = %d, want 1", reader.largeReads)
+	}
+}
+
+func TestBridgeBulkReadPreservesChecksumValidation(t *testing.T) {
+	entry, _, _ := bridgeTestEntry(t)
+	entry.CRC32 ^= 1
+	_, err := readBridgeZipEntry(entry, 512*1024)
+	if !errors.Is(err, zip.ErrChecksum) {
+		t.Fatalf("got %v, want checksum rejection", err)
+	}
+}
+
+func TestBridgeBulkReadRejectsOversizedAndTruncatedComponents(t *testing.T) {
+	entry, _, _ := bridgeTestEntry(t)
+	if _, err := readBridgeZipEntry(entry, 1024); err == nil {
+		t.Fatal("accepted oversized component")
+	}
+	entry.CompressedSize64 += 1024
+	if _, err := readBridgeZipEntry(entry, 512*1024); !errors.Is(err, io.EOF) && !errors.Is(err, io.ErrUnexpectedEOF) {
+		t.Fatalf("got %v, want truncated archive failure", err)
+	}
+}
