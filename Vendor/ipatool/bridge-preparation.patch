+package cmd
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestBridgeAuthCodeHandlesTerminalPasteAndInvisibleFormatting(t *testing.T) {
+	for name, input := range map[string]string{
+		"typed":                    "012345\n",
+		"bracketed paste":          "\x1b[200~012345\x1b[201~\n",
+		"newline inside paste":     "\x1b[200~012345\n\x1b[201~",
+		"CRLF inside paste":        "\x1b[200~012345\r\n\x1b[201~",
+		"invisible SMS formatting": "\u2066012\u200b345\u2069\n",
+		"spaces and newline":       " 012\u00a0345 \r\n",
+		"stray terminal paste end": "012345\x1b[201~\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			var output bytes.Buffer
+			code, err := readBridgeAuthCode(strings.NewReader(input), &output)
+			if err != nil || code != "012345" {
+				t.Fatalf("valid formatted test code was rejected: %v", err)
+			}
+			if strings.Contains(output.String(), "012345") {
+				t.Fatal("prompt logged the code")
+			}
+		})
+	}
+}
+
+func TestBridgeAuthCodeRepromptsLocallyWithoutLoggingRejectedInput(t *testing.T) {
+	var output bytes.Buffer
+	code, err := readBridgeAuthCode(strings.NewReader("bad-input\n12345\n\n012345\n"), &output)
+	if err != nil || code != "012345" {
+		t.Fatalf("retry failed: %v", err)
+	}
+	if strings.Count(output.String(), "enter 2FA code:") != 4 {
+		t.Fatal("malformed input did not reprompt locally")
+	}
+	if strings.Contains(output.String(), "bad-input") || strings.Contains(output.String(), "012345") {
+		t.Fatal("code appeared in output")
+	}
+}
+
+func TestBridgeTerminalLinePreservesFollowingPromptInput(t *testing.T) {
+	input := strings.NewReader("first\r\nsecond\n")
+	first, err1 := readBridgeTerminalLine(input)
+	second, err2 := readBridgeTerminalLine(input)
+	if err1 != nil || err2 != nil || first != "first" || second != "second" {
+		t.Fatal("reading a prompt consumed the next prompt's input")
+	}
+}
+
+func TestBridgeAuthCodeRejectsTruncatedPasteAndUnknownEscape(t *testing.T) {
+	for _, input := range []string{"\x1b[200~012345\n", "012345\x1b[A\n"} {
+		var output bytes.Buffer
+		if _, err := readBridgeAuthCode(strings.NewReader(input), &output); err == nil {
+			t.Fatal("accepted malformed terminal input")
+		}
+	}
+}
