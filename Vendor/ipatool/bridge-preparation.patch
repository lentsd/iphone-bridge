+package assets
+
+import (
+	"archive/zip"
+	"bytes"
+	"compress/flate"
+	"crypto/sha256"
+	"fmt"
+	"hash/crc32"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+func bridgeProgress(message string) {
+	if os.Getenv("IPHONE_BRIDGE_PROGRESS") == "1" {
+		fmt.Fprintln(os.Stderr, "[Подготовка] "+message)
+	}
+}
+
+// Download the compressed ZIP member as a single range before inflating it.
+// Inflating directly from remoteFile causes one HTTP request per small read.
+func readBridgeZipEntry(entry *zip.File, maximum int) ([]byte, error) {
+	if entry.CompressedSize64 > uint64(maximum) || entry.UncompressedSize64 > uint64(maximum) {
+		return nil, fmt.Errorf("ZIP component exceeds size limit")
+	}
+	if entry.Method != zip.Deflate && entry.Method != zip.Store {
+		return nil, fmt.Errorf("unsupported ZIP compression")
+	}
+	raw, err := entry.OpenRaw()
+	if err != nil {
+		return nil, err
+	}
+	compressed := make([]byte, int(entry.CompressedSize64))
+	if _, err = io.ReadFull(raw, compressed); err != nil {
+		return nil, err
+	}
+	var reader io.ReadCloser = io.NopCloser(bytes.NewReader(compressed))
+	if entry.Method == zip.Deflate {
+		reader = flate.NewReader(bytes.NewReader(compressed))
+	}
+	defer reader.Close()
+	data, err := io.ReadAll(io.LimitReader(reader, int64(maximum)+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maximum || uint64(len(data)) != entry.UncompressedSize64 {
+		return nil, fmt.Errorf("unexpected ZIP component size")
+	}
+	if crc32.ChecksumIEEE(data) != entry.CRC32 {
+		return nil, zip.ErrChecksum
+	}
+	return data, nil
+}
+
+func bridgeFileSpec(name string) (fileSpec, bool) {
+	for _, spec := range requiredFiles {
+		if spec.name == name {
+			return spec, true
+		}
+	}
+	return fileSpec{}, false
+}
+
+func reuseBridgeCachedFile(cache, destination, name string) bool {
+	spec, ok := bridgeFileSpec(name)
+	if !ok {
+		return false
+	}
+	data, err := readCacheFile(filepath.Join(cache, name), spec.size)
+	if err != nil || sha256.Sum256(data) != spec.digest {
+		return false
+	}
+	return os.WriteFile(filepath.Join(destination, name), data, 0o600) == nil
+}
+
+func saveBridgeCachedFiles(source, destination string, names []string) error {
+	if err := os.MkdirAll(destination, 0o700); err != nil {
+		return err
+	}
+	for _, name := range names {
+		spec, ok := bridgeFileSpec(name)
+		if !ok {
+			return fmt.Errorf("unknown Apple component")
+		}
+		data, err := readCacheFile(filepath.Join(source, name), spec.size)
+		if err != nil {
+			return err
+		}
+		if sha256.Sum256(data) != spec.digest {
+			return fmt.Errorf("Apple component %s failed SHA-256 verification", name)
+		}
+		if err = replaceFile(filepath.Join(destination, name), data); err != nil {
+			return err
+		}
+	}
+	return nil
+}
